class Wacli < Formula
  desc "CLI for website OpenAPI/Swagger APIs"
  homepage "@HOMEPAGE@"
  url "@URL@"
  sha256 "@SHA256@"
  version "@VERSION@"
  license "0BSD"

  def install
    bin.install "wacli"
  end

  test do
    output = shell_output("#{bin}/wacli --help 2>&1")
    assert_match "wacli", output
  end
end
