+        if out_path == "-"
+          stdout.write(resp.body_bytes)
+          return ok ? 0 : 1
+        end
+
+        File.open(out_path, "wb") { |f| f.write(resp.body_bytes) }
+        stderr.puts "http: #{resp.status_code}"
+        stderr.puts "saved: #{out_path}"
+        return ok ? 0 : 1
+      end
