+          stderr.puts "http: #{resp.status_code}"
+          stderr.puts "saved: #{path}"
+          return ok ? 0 : 1
+        else
+          raise "response looks like a file; re-run with --out PATH"
+        end
+      end
+
+      Render::Engine.render(resp.body_bytes, mode, stdout, cfg.render)
+      ok ? 0 : 1
+    end
